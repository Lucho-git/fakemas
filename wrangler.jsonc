{
  // Cloudflare serves this folder as a static site: there is no build step and no
  // Worker code. Files listed in .assetsignore are left out of the upload.
  // Must match the project's name in the Cloudflare dashboard.
  "name": "fakemas",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./"
  }
}
